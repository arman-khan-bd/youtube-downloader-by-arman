<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_badge" />

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TubePipe Audio Player"
            android:textColor="@color/yt_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Background Play Active"
            android:textColor="@color/yt_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Large Album Art / Thumbnail -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/yt_surface_dark"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/yt_border_dark"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/iv_audio_large_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumbnail_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="Album Art" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Title and Artist -->
    <TextView
        android:id="@+id/tv_audio_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textAlignment="center"
        android:textColor="@color/yt_text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Audio Song Title Playing Here" />

    <TextView
        android:id="@+id/tv_audio_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="center"
        android:textColor="@color/yt_text_secondary"
        android:textSize="13sp"
        tools:text="Artist or Channel Name" />

    <!-- Seekbar & Times -->
    <SeekBar
        android:id="@+id/audio_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:progressTint="@color/yt_red"
        android:thumbTint="@color/yt_red" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tv_audio_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="@color/yt_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_audio_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/yt_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_audio_rewind"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="Rewind 10s" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_audio_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="28dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/yt_red"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/iv_audio_play_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pause"
                app:tint="@color/white"
                android:contentDescription="Play or Pause" />
        </com.google.android.material.card.MaterialCardView>

        <ImageButton
            android:id="@+id/btn_audio_forward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:rotation="180"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="Forward 10s" />
    </LinearLayout>

</LinearLayout>
