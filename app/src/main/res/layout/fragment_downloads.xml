<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yt_black"
    android:orientation="vertical">

    <!-- Downloads Category Tabs: Videos vs Audios -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_downloads"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/yt_surface_dark"
        app:tabIndicatorColor="@color/yt_red"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/yt_text_primary"
        app:tabTextColor="@color/yt_text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_video"
            android:text="Videos" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_audio"
            android:text="Audios" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_downloads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <!-- Empty state layout -->
        <LinearLayout
            android:id="@+id/layout_empty_downloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:id="@+id/iv_empty_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_downloads_nav"
                app:tint="@color/yt_border_dark"
                android:contentDescription="Empty" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="No Downloads Yet"
                android:textColor="@color/yt_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/no_downloads"
                android:textColor="@color/yt_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
